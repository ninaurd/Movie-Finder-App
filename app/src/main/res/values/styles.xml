<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TopToolbarStyle" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/main_blue</item>
        <item name="titleTextAppearance">@style/ToolbarTextStyle</item>
        <item name="navigationIconTint">@color/white_day_night</item>
    </style>

    <style name="ToolbarTextStyle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/white_day_night</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/ubuntu_bold</item>
        <item name="android:textSize">@dimen/toolbar_text_size_regular</item>
    </style>

    <style name="ToolbarTextStyleBigger" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/white_day_night</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/ubuntu_bold</item>
        <item name="android:textSize">@dimen/toolbar_text_size_bigger</item>
    </style>

    <style name="BottomToolbarStyle" parent="Widget.Design.BottomNavigationView">
        <item name="android:background">@color/main_blue</item>
        <item name="titleTextAppearance">@style/ToolbarTextStyle</item>
        <item name="itemIconTint">@color/white_day_night</item>
        <item name="itemTextColor">@color/white_day_night</item>
        <item name="itemIconSize">@dimen/item_icon_size</item>
    </style>

    <style name="ImagesContainerStyle">
        <item name="android:background">@color/main_blue</item>
    </style>

    <style name="TopTitleStyle">
        <item name="android:background">@color/main_blue_lighter</item>
        <item name="android:fontFamily">@font/ubuntu_bold</item>
        <item name="android:textColor">@color/white_day_night</item>
        <item name="android:textSize">@dimen/title_text_size_regular</item>
    </style>

    <style name="TopTitleStyleBigger">
        <item name="android:background">@color/main_blue_lighter</item>
        <item name="android:fontFamily">@font/ubuntu_bold</item>
        <item name="android:textColor">@color/white_day_night</item>
        <item name="android:textSize">@dimen/title_text_size_bigger</item>
    </style>


</resources>